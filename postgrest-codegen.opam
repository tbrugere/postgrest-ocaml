# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Generates postgrest column declarations from a Postgres catalog"
description: """
postgrest-codegen reads the Postgres catalog of a database's tables (the
output of its catalog.sql) and prints the Postgrest.Col declarations of
those tables as OCaml. A build-time tool, separate from the postgrest
library so that the library does not depend on ppxlib."""
maintainer: ["Tristan Brugère"]
authors: ["Tristan Brugère"]
license: "MIT"
homepage: "https://github.com/tbrugere/herbier"
bug-reports: "https://github.com/tbrugere/herbier/issues"
depends: [
  "dune" {>= "3.24"}
  "ocaml" {>= "5.3"}
  "postgrest" {= version}
  "yojson" {>= "2.0"}
  "ppxlib" {>= "0.36"}
  "ppx_deriving_yojson" {>= "3.10"}
  "alcotest" {with-test}
  "fmt" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/tbrugere/herbier.git"
x-maintenance-intent: ["(latest)"]
