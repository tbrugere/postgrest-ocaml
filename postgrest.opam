# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Sans-IO PostgREST client: typed columns, rows, filters, requests"
description: """
postgrest builds PostgREST requests and decodes their responses with typed
columns, rows and filters. It performs no IO: plug in any HTTP client."""
maintainer: ["Tristan Brugère"]
authors: ["Tristan Brugère"]
license: "CECILL-B"
homepage: "https://github.com/tbrugere/postgrest-ocaml"
bug-reports: "https://github.com/tbrugere/postgrest-ocaml/issues"
depends: [
  "dune" {>= "3.24"}
  "ocaml" {>= "5.3"}
  "yojson" {>= "2.0"}
  "ptime" {>= "1.0"}
  "ppx_string"
  "uri" {>= "4.0"}
  "alcotest" {with-test}
  "ocamlformat" {with-dev-setup & = "0.29.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/tbrugere/postgrest-ocaml.git"
x-maintenance-intent: ["(latest)"]
