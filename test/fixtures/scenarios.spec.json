      "headers": {
        "Accept": "application/json"
      }
    },
    {
      "name": "select_tree_value_with_comma",
      "method": "GET",
      "path_query": "/plants?or=(name.eq.\"Plante, inconnue\",name.eq.Arnica)&select=id,name&order=id",
      "headers": {
        "Accept": "application/json"
      }
    },
