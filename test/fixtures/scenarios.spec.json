{
  "_comment": "Requests to replay against a real PostgREST. path_query is written UNENCODED; the recorder percent-encodes it (curl --data-urlencode style per value is NOT used: encode the whole query string with the rules: space, &, =, +, #, %, \" and non-ASCII are encoded; , ( ) . : * { } are left as is). Scenarios with reset=true run on a freshly seeded database.",
  "base": "http://localhost:3000",
  "scenarios": [
    {
      "name": "select_all_plants",
      "method": "GET",
      "path_query": "/plants?select=id,name,scientific_name,status,rating,height_cm,is_native,created_at,tags&order=name",
      "headers": {
        "Accept": "application/json"
      }
    },
    {
      "name": "select_one_plant",
      "method": "GET",
      "path_query": "/plants?id=eq.00000000-0000-0000-0000-000000000001&select=id,name",
      "headers": {
        "Accept": "application/vnd.pgrst.object+json"
      }
    },
    {
      "name": "select_one_missing",
      "method": "GET",
      "path_query": "/plants?id=eq.00000000-0000-0000-0000-000000000099&select=id,name",
      "headers": {
        "Accept": "application/vnd.pgrst.object+json"
      }
    },
    {
      "name": "select_eq_with_space",
      "method": "GET",
      "path_query": "/plants?scientific_name=eq.Arnica montana&select=id,name",
      "headers": {
        "Accept": "application/json"
      }
    },
    {
      "name": "select_eq_with_comma",
      "method": "GET",
      "path_query": "/plants?name=eq.Plante, inconnue&select=id,name",
      "headers": {
