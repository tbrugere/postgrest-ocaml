      "path_query": "/plants?status=in.(active,archived)&select=id,status&order=id",
      "headers": {
        "Accept": "application/json"
      }
    },
    {
      "name": "select_in_with_quoted_comma",
      "method": "GET",
      "path_query": "/plants?name=in.(\"Plante, inconnue\",Arnica)&select=id,name&order=id",
      "headers": {
        "Accept": "application/json"
      }
    },
    {
      "name": "select_or",
      "method": "GET",
      "path_query": "/plants?or=(rating.gte.4,is_native.is.true)&select=id,name&order=id",
      "headers": {
        "Accept": "application/json"
      }
    },
    {
      "name": "select_and_in_tree",
      "method": "GET",
      "path_query": "/plants?and=(rating.not.is.null,name.like.A*)&select=id,name",
      "headers": {
        "Accept": "application/json"
      }
    },
    {
      "name": "select_not_or",
      "method": "GET",
